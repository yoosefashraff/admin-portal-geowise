# Next.js Environment Variables
# Copy this file to .env and fill in the values

# API Configuration
NEXT_PUBLIC_DEV_API_URL=https://gw5cndev.geowise.ai
NEXT_PUBLIC_API_URL=https://gw5cn.geowise.ai

# Google Maps API Key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# FTP Deployment Credentials (for automated deployment)
# Get these from the backend team
FTP_HOST=8.213.23.175
FTP_PORT=21
FTP_USER=ftpuser
FTP_PASSWORD=your_ftp_password_here
FTP_PASSIVE=false

# Note: .env file is gitignored - never commit passwords!
